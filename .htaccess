Options -Indexes
RewriteEngine On

# Dynamically figure out what subfolder we are currently sitting inside
RewriteCond %{REQUEST_URI} ^/([^/]+)/
RewriteRule ^ - [E=CURRENT_DIR:%1]

# Remove .html extension using the dynamic folder name (prevents redirect loops)
RewriteCond %{THE_REQUEST} /%{ENV:CURRENT_DIR}/([^.]+)\.html [NC]
RewriteRule ^([^.]+)\.html$ /%{ENV:CURRENT_DIR}/$1 [R=301,L]

# Serve .html file transparently for clean URL requests
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Force HTTPS safely
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]